{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Enterprise Inference Values",
    "description": "A schema to validate the values.yaml file for the Enterprise Inference Helm chart.",
    "type": "object",
    "properties": {
        "nameOverride": {
            "type": "string",
            "description": "Override the name of the chart."
        },
        "fullnameOverride": {
            "type": "string",
            "description": "Override the full name of the chart."
        },
        "device": {
            "type": "string",
            "enum": ["hpu", "cpu"],
            "description": "Target device for deployment."
        },
        "main": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Enable or disable the main component."
                },
                "config": {
                    "type": "object",
                    "properties": {
                        "storageClassName": {
                            "type": "string",
                            "description": "Storage class for the PVC."
                        },
                        "clusterUrl": {
                            "type": "string",
                            "description": "The base URL to host the inference endpoint."
                        },
                        "models": {
                            "type": "array",
                            "items": {
                                "type": "integer"
                            },
                            "description": "A list of the model numbers from the list of pre-validated models."
                        },
                        "cpuOrGpu": {
                            "type": "string",
                            "enum": ["cpu", "gpu", "gaudi2", "gaudi3"],
                            "description": "The target platform to deploy the model."
                        },
                        "sshKeyName": {
                            "type": "string",
                            "description": "Name of the SSH key pair."
                        },
                        "ipAddress": {
                            "type": "string",
                            "description": "IP address of the machine."
                        },
                        "certsPath": {
                            "type": "string",
                            "description": "Path to the certificates."
                        },
                        "certFile": {
                            "type": "string",
                            "description": "Certificate file name."
                        },
                        "keyFile": {
                            "type": "string",
                            "description": "Key file name."
                        },
                        "keycloakClientId": {
                            "type": "string",
                            "description": "Keycloak client ID."
                        },
                        "keycloakAdminUser": {
                            "type": "string",
                            "description": "Keycloak admin username."
                        },
                        "keycloakAdminPassword": {
                            "type": "string",
                            "description": "Keycloak admin password."
                        },
                        "deployKubernetesFresh": {
                            "type": "string",
                            "description": "Deploy Kubernetes fresh configuration."
                        },
                        "deployIngressController": {
                            "type": "string",
                            "description": "Deploy ingress controller."
                        },
                        "deployKeycloakApisix": {
                            "type": "string",
                            "description": "Deploy Keycloak with Apisix."
                        },
                        "deployObservability": {
                            "type": "string",
                            "description": "Deploy observability stack."
                        },
                        "deployLlmModels": {
                            "type": "string",
                            "description": "Deploy LLM models."
                        }
                    },
                    "required": ["storageClassName", "clusterUrl", "models", "cpuOrGpu"]
                },
                "upstream": {
                    "type": "object",
                    "properties": {
                        "repository": {
                            "type": "string",
                            "description": "Repository URL for upstream configuration."
                        },
                        "branch": {
                            "type": "string",
                            "description": "Branch name for upstream configuration."
                        },
                        "configPath": {
                            "type": "string",
                            "description": "Path to the upstream configuration file."
                        }
                    },
                    "required": ["repository", "branch", "configPath"]
                },
                "secrets": {
                    "type": "object",
                    "properties": {
                        "huggingFaceToken": {
                            "type": "string",
                            "description": "Hugging Face token to access models."
                        }
                    },
                    "required": ["huggingFaceToken"]
                },
                "securityContext": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Enable or disable security context."
                        },
                        "fsGroup": {
                            "type": "integer",
                            "description": "Filesystem group ID."
                        },
                        "runAsUser": {
                            "type": "integer",
                            "description": "User ID to run the application."
                        },
                        "runAsGroup": {
                            "type": "integer",
                            "description": "Group ID to run the application."
                        },
                        "runAsNonRoot": {
                            "type": "boolean",
                            "description": "Run the application as a non-root user."
                        }
                    }
                },
                "service": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "enum": ["ClusterIP", "NodePort", "LoadBalancer"],
                            "description": "Type of Kubernetes service."
                        },
                        "port": {
                            "type": "integer",
                            "description": "Port for the service."
                        }
                    },
                    "required": ["type", "port"]
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "hpu": {
                            "type": "object",
                            "properties": {
                                "limits": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        },
                                        "habana.ai/gaudi": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "requests": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        },
                                        "habana.ai/gaudi": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        },
                        "cpu": {
                            "type": "object",
                            "properties": {
                                "limits": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "requests": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "persistence": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Enable or disable persistence."
                        },
                        "size": {
                            "type": "string",
                            "description": "Size of the persistent volume."
                        }
                    },
                    "required": ["enabled", "size"]
                }
            }
        },
        "modelServing": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Enable or disable model serving."
                },
                "service": {
                    "type": "object",
                    "properties": {
                        "port": {
                            "type": "integer",
                            "description": "Port for the model serving service."
                        },
                        "targetPort": {
                            "type": "integer",
                            "description": "Target port for the model serving service."
                        }
                    },
                    "required": ["port", "targetPort"]
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "hpu": {
                            "type": "object",
                            "properties": {
                                "limits": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        },
                                        "habana.ai/gaudi": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "requests": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        },
                                        "habana.ai/gaudi": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        },
                        "cpu": {
                            "type": "object",
                            "properties": {
                                "limits": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "requests": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}